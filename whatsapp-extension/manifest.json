{
  "manifest_version": 3,
  "name": "Resolve Notebook - Assistente WhatsApp",
  "version": "1.0.0",
  "description": "Extensão oficial da Resolve Notebook para agilizar o atendimento no WhatsApp: disparo sem salvar número, respostas prontas, OS rápida e localização.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Resolve Notebook WhatsApp CRM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
